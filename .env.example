# Public URL of your app (required on Railway)
BASE_URL=https://your-app.up.railway.app

# Random secret for sessions (generate: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
# ВАЖНО: замени на НАСТОЯЩИЕ ключи, не оставляй your-client-id!
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# PostgreSQL (auto-set when you add Postgres on Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Admin panel access (your Google email)
ADMIN_EMAILS=your@gmail.com

# Keep the same value across deploys — changing it logs everyone out
SESSION_SECRET=long-random-string-here
